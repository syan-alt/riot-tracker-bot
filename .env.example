# For local development point these at the dev bot / dev server and set
# DEV_MODE=true to register the /dev_* commands. Servers pick their report
# channel with /setup; NOTIFICATION_CHANNEL_ID is only where the admin cli
# posts test reports when --channel is left off.
DISCORD_BOT_TOKEN=
NOTIFICATION_CHANNEL_ID=
HENRIK_API_KEY=
RIOT_API_KEY=
RIOT_TFT_API_KEY=
DEV_MODE=false
LOG_LEVEL=Info

# Optional. Dedicated throwaway Discord *user* account for cloud-agent
# computer-use verification (https://discord.com/login). Never a personal
# account. Discord login is email/phone, not display name. Inject these as
# Cursor Cloud environment secrets; do not commit values.
AGENT_EMAIL=
AGENT_EMAIL_PASSWORD=
DISCORD_TEST_CHANNEL_URL=

# Production persistence and one-time Rust JSON migration.
DB_PATH=riot-tracker.sqlite
LEGACY_DB_PATH=

# Optional until riot approves the products: a VALORANT product key moves
# VALORANT off henrik, and an RSO client turns on /link. PUBLIC_URL is where
# riot's sign-in returns to (<PUBLIC_URL>/rso/callback); PORT the web server's.
RIOT_VAL_API_KEY=
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
PUBLIC_URL=
PORT=3000

# Optional. Each account's region is resolved and stored at signup; these are
# only fallbacks. RIOT_REGION is the account-v1 cluster (americas/europe/asia/
# sea), VAL_REGION the henrik region used when an account has none stored.
RIOT_REGION=americas
VAL_REGION=na
VAL_PLATFORM=pc
